{
  "name": "safqah-mvp",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "deploy": "cross-env WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext deploy",
    "test": "npm run test:unit && npm run build && node --test tests/smoke.test.mjs",
    "test:unit": "tsx --test tests/requirement-assistant.test.ts tests/llama-provider.test.ts",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern drizzle",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:pg": "tsx scripts/start-embedded-pg.ts",
    "db:migrate": "tsx db/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx db/seed.ts",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "db:verify": "tsx scripts/verify-db.ts",
    "db:recreate-utf8": "tsx scripts/recreate-db-utf8.ts",
    "db:check-encoding": "tsx scripts/check-encoding.ts",
    "db:verify-arabic": "tsx scripts/verify-arabic-utf8.ts",
    "test:e2e-workflow": "tsx scripts/e2e-workflow-check.ts",
    "eval:llama": "tsx scripts/eval-llama.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.8",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "0.45.2",
    "jose": "^6.2.4",
    "next": "16.2.6",
    "openai": "^7.0.0",
    "postgres": "^3.4.9",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "0.31.10",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
