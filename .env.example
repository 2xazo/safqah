DATABASE_URL=
SESSION_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000
DEMO_AUTH_ENABLED=true
# Local embedded Postgres (recommended on Windows without Docker):
# 1) npm run db:pg
# 2) DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54329/safqah
# Docker Compose alternative (after `docker compose up -d`):
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/safqah
# Hosted Supabase example:
# DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres

# AI-assisted requirement drafting (optional, server-only — never NEXT_PUBLIC_*):
# Primary engine: Meta Llama on Cloudflare Workers AI.
# Put these in BOTH .env.local AND .dev.vars (and as Worker secrets in production).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# LLAMA_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
# SAFQAH_AI_PROVIDER=llama   # set to "openai" to use the fallback below
#
# Fallback engine (OpenAI):
# Put the same key in BOTH .env.local AND .dev.vars for local vinext/Cloudflare.
# Production: set as a Cloudflare Worker secret (wrangler secret / dashboard).
OPENAI_API_KEY=
# legacy fallback only: SAFQAH_AI_API_KEY=
# SAFQAH_AI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-5.6
